# Python
__pycache__/
*.py[cod]
.venv/
venv/
.venv-marker
venv-marker/
*.egg-info/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Source PDFs (reference material. The converted markdown lives in knowledge_base/)
docs/*.pdf

# Internal working material for specific calls/reviews, not user documentation.
docs/showcase_demo_script.md
docs/expert_validation_sheet.md
docs/PDF-to-Markdown.md

# NS standards are copyrighted (Standard Norge) — the converted markdown stays
# local. Supply your own copies; see README. The folders ship with a README.md
# only, so a fresh clone shows where the files go; their contents stay local.
knowledge_base/NS-3451_dir/*
knowledge_base/NS-3457_dir/*
!knowledge_base/NS-3451_dir/README.md
!knowledge_base/NS-3457_dir/README.md

# Raw building data can be large, so we track the folder, not the dumps.
data/raw/*
data/training/*

# COLLECTiEF dataset (65 GB) + Metasys dumps/screenshots — never in git.
knowledge_base/incoming/

# Derived from the real COLLECTiEF dataset — not needed to build a pipeline
# (the synthetic tests/fixtures/collectief_mini ships instead), so kept local.
knowledge_base/collectief_index/
knowledge_base/collectief_survey.md

# Building-specific operational context stays local (the repo is public):
# topology surveys, meter serials, BMS screenshots, school indexes, and the
# org-internal Metasys console tooling.
docs/images/
docs/fjernvarmemaalere_skoler.html
knowledge_base/*_building_survey.md
knowledge_base/meter_hierarchies.md
knowledge_base/school_index/
src/extract/metasys_crawl.js
src/extract/metasys_room_probe.js

# Deployment-specific adapters (our schools' BMS grammars + the Metasys API
# tooling) — the public repo demonstrates the adapter pattern with the
# source-agnostic core + collectief_adapter + synthetic fixtures instead.
src/extract/metasys_dump.py
src/heating/metasys_rooms.py
src/heating/metasys_join.py
src/heating/tasen_index.py
src/heating/tasen_extract.py
src/heating/skoyen_extract.py
tests/test_metasys_dump.py
tests/test_heating_metasys_rooms.py
tests/test_heating_metasys_join.py
tests/test_heating_tasen_index.py
tests/test_heating_tasen_extract.py
tests/test_heating_skoyen_extract.py

# Decode runs are regenerable outputs (outputs.jsonl, report, errors)
runs/

# Local env vars (passwords, keys)
.env

# Keep empty tracked folders
!**/.gitkeep

# Local Claude Code state stays private, but the /decode and /enrich skills
# are part of the pipeline (the LLM leg) and ship with the repo.
.claude/*
!.claude/skills/
claude/
goals.md
