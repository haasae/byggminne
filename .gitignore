# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Raw building data can be large — track the folder, not the dumps.
# Comment out the next line if you DO want CSVs in git.
# NB: needs `**` to recurse into subfolders (e.g. data/raw/skoyen/, data/raw/tasen/).
data/raw/**/*.csv

# Keep empty tracked folders
!**/.gitkeep
